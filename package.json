{
  "name": "sift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "One-page dashboard for SonarCloud findings, with Markdown/CSV export designed for LLM-assisted remediation planning.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "autoprefixer": "10.5.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": "20.x"
  }
}
